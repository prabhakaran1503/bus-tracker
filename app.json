{
  "expo": {
    "name": "bus-tracker",
    "slug": "bus-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bustracker",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Bus Tracker to access your location",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Bus Tracker to access your location"
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },

    "web": {
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bus Tracker to access location"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "EXPO_PUBLIC_FIREBASE_API_KEY": "AIzaSyAGsgLw2bHvY2F3ZPwNzeJIq3uN7MjTtbM",
      "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "smartbustracker-63aab.firebaseapp.com",
      "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "smartbustracker-63aab",
      "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "smartbustracker-63aab.firebasestorage.app",
      "EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "813475567306",
      "EXPO_PUBLIC_FIREBASE_APP_ID": "1:813475567306:web:1b0d916c888328dc7f8633"
    }
  }
}
